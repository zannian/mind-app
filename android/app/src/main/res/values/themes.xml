<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mind" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FFF8F5</item>
        <item name="android:navigationBarColor">#FFF8F5</item>
        <item name="android:windowBackground">#FFF8F5</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Mind.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Mind</item>
    </style>
</resources>
